<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Tamp.Pnpm.V12</RootNamespace>
    <AssemblyName>Tamp.Pnpm.V12</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Tamp.Pnpm.V12</PackageId>
    <Description>Tamp wrapper for the pnpm package manager (v12): typed install (frozen-lockfile always explicit), add, remove, run, exec, dlx (exact versions only), fetch, audit, store, pack, publish, deploy and an idempotent version stamp, with registry credentials passed as redacted secrets through the environment and the config variables pnpm honours pinned.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(TampCorePath)" Condition="'$(TampCoreMode)' == 'project'" />
    <PackageReference Include="Tamp.Core" Condition="'$(TampCoreMode)' == 'package'" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>
